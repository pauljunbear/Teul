{
  "name": "teul-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/notices.mjs",
    "lint": "oxlint src --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "node scripts/smoke.mjs",
    "test:feedback": "node scripts/feedback-smoke.mjs",
    "feedback": "node scripts/feedback.mjs",
    "feedback:read": "node scripts/feedback-read.mjs",
    "audit": "npm audit --audit-level=moderate",
    "test:storage": "node scripts/storage-smoke.mjs",
    "test:authoring": "node scripts/authoring-smoke.mjs",
    "test:authoring-performance": "node scripts/authoring-performance.mjs",
    "test:guidelines": "node scripts/guideline-smoke.mjs",
    "test:guideline-assistance": "npm --prefix ../services/guideline-intake run build && node scripts/guideline-assistance-smoke.mjs",
    "test:guideline-source-set": "node scripts/guideline-source-set-smoke.mjs",
    "test:guideline-numeric": "node scripts/guideline-numeric-smoke.mjs",
    "test:guideline-statement-review": "node scripts/guideline-statement-review-smoke.mjs",
    "test:guideline-manual-refresh": "node scripts/guideline-manual-refresh-smoke.mjs",
    "test:guideline-manual": "node scripts/guideline-manual-smoke.mjs",
    "test:guideline-figma": "npm --prefix ../services/guideline-intake run build && node scripts/guideline-figma-smoke.mjs",
    "test:guideline-figma-review": "npm --prefix ../services/guideline-intake run build && node scripts/guideline-figma-review-smoke.mjs",
    "test:guideline-capacity": "node scripts/guideline-capacity.mjs",
    "proof:guideline-application": "node scripts/guideline-application-proof.mjs",
