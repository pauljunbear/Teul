    "test:guideline-cross-format": "npm --prefix ../services/guideline-intake run build && node scripts/guideline-cross-format.mjs",
    "test:guideline-output-recovery": "node scripts/guideline-output-recovery-smoke.mjs",
    "test:guideline-refresh": "node scripts/guideline-refresh-smoke.mjs",
    "test:guideline-gradients": "node scripts/guideline-gradient-smoke.mjs",
    "test:guideline-supporting": "node scripts/guideline-supporting-smoke.mjs",
    "test:guideline-storage": "node scripts/guideline-storage-smoke.mjs",
    "test:guideline-recovery-storage": "node scripts/guideline-recovery-storage-smoke.mjs",
    "test:guideline-native-refresh": "node scripts/guideline-native-refresh-smoke.mjs",
    "test:guideline-composition-refresh": "node scripts/guideline-composition-refresh-smoke.mjs",
    "test:guideline-gradient-assessment": "node scripts/guideline-gradient-assessment-smoke.mjs",
    "test:guideline-gradient-catalog": "node scripts/guideline-gradient-catalog-smoke.mjs",
    "test:guideline-gradient-worker": "node scripts/guideline-gradient-worker-smoke.mjs",
    "test:guideline-gradient-performance": "node scripts/guideline-gradient-performance.mjs",
    "test:guideline-source-set-storage": "node scripts/guideline-source-set-storage-smoke.mjs",
    "test:guideline-accessibility": "node scripts/guideline-accessibility.mjs",
    "test:guideline-task-flow": "node scripts/guideline-task-flow.mjs",
    "test:guideline-source-scale": "node scripts/guideline-source-scale-smoke.mjs",
    "test:guideline-host": "npm --prefix ../services/guideline-intake run build && node scripts/guideline-host-smoke.mjs",
    "test:guideline-host-integration": "npm --prefix ../services/guideline-intake run build && node scripts/guideline-host-integration.mjs",
