{
  "name": "teul",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "npm": "10.x"
  },
  "description": "Teul helps designers explore historical color, build tested color systems, and apply documented layout grids in Figma.",
  "main": "dist/code.js",
  "scripts": {
    "audit": "node --test scripts/dependency-audit-policy.test.mjs && node scripts/dependency-audit-policy.mjs",
    "audit:raw": "npm audit --audit-level=moderate",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "test:audit-policy": "node --test scripts/dependency-audit-policy.test.mjs",
    "build": "webpack --mode=production",
    "build:generic-candidate": "webpack --mode=production --env genericColorBuilder=true",
    "assert:artifacts": "node scripts/assert-build-artifacts.js",
    "assert:generic-candidate-artifacts": "TEUL_DIST_DIR=figma-candidate/dist node scripts/assert-build-artifacts.js --generic-channel=candidate",
    "check:ui-bundle": "node scripts/check-ui-bundle.js",
    "check:generic-candidate-ui-bundle": "TEUL_DIST_DIR=figma-candidate/dist node scripts/check-ui-bundle.js",
    "report:dead-code": "node scripts/report-dead-exports.js",
    "report:bundle": "node scripts/report-bundle-composition.js",
    "dev": "webpack --mode=development --watch",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:production-ui": "node scripts/smoke-production-ui.js",
    "test:generic-candidate-ui": "TEUL_DIST_DIR=figma-candidate/dist node scripts/smoke-production-ui.js",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:generic-source-benchmark": "node scripts/benchmark-color-system-generic-source.js",
    "verify:generic-sanitization": "node scripts/verify-generic-candidate-sanitization.js",
    "verify:color-foundations": "node --test scripts/verify-color-foundations.test.mjs && node scripts/verify-color-foundations.mjs",
    "verify:wada": "node scripts/verify-wada-upstream.mjs",
    "werner:sample": "node scripts/werner-sampling/sample.mjs",
    "prepare": "husky"
  },
  "author": "Paul Jun",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "lucide-react": "^1.24.0",
    "preact": "^10.29.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "overrides": {
    "brace-expansion@^1.0.0": "1.1.18",
    "brace-expansion@^2.0.0": "2.1.4",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@figma/plugin-typings": "^1.138.0",
    "@radix-ui/colors": "3.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/coverage-v8": "^4.1.11",
    "apca-w3": "0.1.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.6",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.6.2",
    "typescript": "^5.2.2",
    "vitest": "^4.1.11",
    "webpack": "^5.110.3",
    "webpack-cli": "^5.1.4"
  }
}
